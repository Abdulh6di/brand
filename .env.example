# ─────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL). DIRECT_URL is used for migrations if you put your
# app behind a pooler (e.g. PgBouncer / Prisma Accelerate) — otherwise it
# can be the same as DATABASE_URL.
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/aelia?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/aelia?schema=public"

# ─────────────────────────────────────────────────────────────────────────
# Auth.js — generate a secret with `openssl rand -base64 32`
# ─────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AELIA"

# ─────────────────────────────────────────────────────────────────────────
# Seed-only admin credentials. Never used outside `prisma/seed.ts` — do not
# put real production credentials here; rotate the password after first
# login in a real deployment.
# ─────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@aelia.dev"
ADMIN_PASSWORD="ChangeMe123!"

# ─────────────────────────────────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` (local) or the webhook
# endpoint you register in the Stripe dashboard (production).
# ─────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# Cloudinary — used for product/custom-order image uploads
# ─────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────────────────────────────────
# Resend — transactional email (order confirmations, password resets, etc.)
# ─────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="AELIA <no-reply@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────
# WhatsApp — click-to-chat works with just the phone number; the API token
# is only needed for automated server-initiated messages (see
# src/server/whatsapp.ts).
# ─────────────────────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
NEXT_PUBLIC_WHATSAPP_NUMBER="15551234567"

# ─────────────────────────────────────────────────────────────────────────
# Redis — optional. Enables shared rate limiting across instances; falls
# back to an in-process limiter when unset (fine for local dev / single
# instance).
# ─────────────────────────────────────────────────────────────────────────
REDIS_URL=""

# ─────────────────────────────────────────────────────────────────────────
# Analytics — optional, scripts only load when these are set
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ─────────────────────────────────────────────────────────────────────────
# Error monitoring — optional
# ─────────────────────────────────────────────────────────────────────────
SENTRY_DSN=""
